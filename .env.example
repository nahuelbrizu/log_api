# Copy this file to .env and fill in your values: cp .env.example .env
# Never commit .env. In production set these as real environment variables.

# --- Database (MySQL) ----------------------------------------------------
DATABASE_USERNAME=root
DATABASE_PASSWORD=
# Use a TCP host (Docker, CI, remote DB). Leave empty to use the local socket.
DATABASE_HOST=
DATABASE_PORT=3306
# DATABASE_SOCKET=/var/run/mysqld/mysqld.sock
# Production database name (dev/test are app_named_poly_development/_test)
# DATABASE_NAME=app_named_poly_production

# --- Public URLs ---------------------------------------------------------
# Public base URL of this API (email links, OAuth callback URLs).
API_URL=http://localhost:3000
# Your frontend. Used as default for CORS, the reset-password page and the
# OAuth return URI.
FRONTEND_URL=http://localhost:5173

# --- Tokens --------------------------------------------------------------
# Secret used to sign JWT access tokens. Generate with: bin/rails secret
# Required in production; in development it falls back to secret_key_base.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OAUTH_CODE_TTL_SECONDS=60
# Optional extra secret mixed into password hashes (changing it later
# invalidates all passwords).
DEVISE_PEPPER=

# --- CORS / OAuth redirects ----------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173
# Comma-separated, EXACT URIs the social login may send users back to
# (web pages or mobile app schemes). Default: FRONTEND_URL/oauth/callback
OAUTH_REDIRECT_ALLOWLIST=http://localhost:5173/oauth/callback,myapp://oauth/callback

# --- Email links pointing to your frontend (optional) --------------------
# Page that reads ?confirmation_token=... and POSTs it to /auth/confirmation.
# Empty: the email links straight to GET /auth/confirmation on this API.
CONFIRMATION_URL=
# Page that reads ?reset_password_token=... and PUTs /auth/password.
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# --- Social login providers (each one is enabled only when both are set) --
# Callback URL to register in each console: API_URL/auth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# --- Email (SMTP) --------------------------------------------------------
# Without MAILER_USERNAME, development writes emails to tmp/mails/.
MAILER_SENDER=no-reply@example.com
MAILER_ADDRESS=smtp.mailgun.org
MAILER_PORT=587
MAILER_DOMAIN=
MAILER_USERNAME=
MAILER_PASSWORD=

# --- Production only -----------------------------------------------------
# SECRET_KEY_BASE=          # bin/rails secret
# RAILS_LOG_TO_STDOUT=1
# FORCE_SSL=true
# SEED_DEMO_USER=1          # allow db:seed to create the demo user

# --- Demo seed (db/seeds.rb) ---------------------------------------------
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo-password-123
