#!/usr/bin/env ruby
require "fileutils"

# Path to your application root.
APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args) || abort("\n== Command #{args} failed ==")
end

FileUtils.chdir APP_ROOT do
  # Idempotent: safe to run again at any time.

  puts "== Installing dependencies =="
  system! "gem install bundler --conservative"
  system("bundle check") || system!("bundle install")

  puts "\n== Copying .env =="
  if File.exist?(".env")
    puts ".env already exists, leaving it untouched"
  else
    FileUtils.cp ".env.example", ".env"
    puts "Created .env from .env.example. Review DATABASE_* before continuing if needed."
  end

  puts "\n== Preparing database (create + schema + seed on first run) =="
  system! "bin/rails db:prepare"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Done. Start the API with: bin/rails server =="
end
